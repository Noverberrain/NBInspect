pkgtype(kind: "foreign_library")

supported_targets = "js"

import {
  "Noverberrain/nbinspect" @nb,
  "moonbitlang/core/json",
}

options(
  link: {
    "js": {
      "format": "esm",
      "exports": [
        "nbinspect_analyze",
        "nbinspect_render_report",
        "nbinspect_review",
        "nbinspect_render_review",
        "nbinspect_analyze_with_policy",
        "nbinspect_review_with_policy",
        "nbinspect_parse_policy",
        "nbinspect_profile",
      ],
    },
  },
)
